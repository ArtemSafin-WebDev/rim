<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="format-detection" content="telephone=no">
    <script src="assets/js/ie11CustomProperties.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />

    <link rel="stylesheet" href="css/blank-page.css" />
    <link rel="stylesheet" href="css/newest-header.css" />
    <title>
        {{ title }}
    </title>
</head>

<body class="no-touch" ontouchstart="">
    <div class="sprite" aria-hidden="true" style="position: absolute; width: 0; height: 0; overflow: hidden;">
        {{> sprite }}
    </div>

    <div class="page-content">
        {{> newest-header-lenta-light }}
        <main class="page-main page-main--header-preview">
            {{#block "main"}}

            {{/block}}
        </main>
        {{> ie-placeholder }}
    </div>

    <script type="module" src="assets/js/new-header.js"></script>
</body>

</html>
